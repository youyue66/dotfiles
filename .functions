# ~/.functions — shell functions

# Create directory and enter it
mkcd() {
    mkdir -p "$1" && cd "$1"
}

# Extract archives
extract() {
    if [ -f "$1" ]; then
        case "$1" in
            *.tar.bz2)  tar xjf "$1"      ;;
            *.tar.gz)   tar xzf "$1"      ;;
            *.bz2)      bunzip2 "$1"      ;;
            *.gz)       gunzip "$1"       ;;
            *.tar)      tar xf "$1"       ;;
            *.tbz2)     tar xjf "$1"      ;;
            *.tgz)      tar xzf "$1"      ;;
            *.zip)      unzip "$1"        ;;
            *) echo "Unknown archive: $1" ;;
        esac
    else
        echo "File not found: $1"
    fi
}
\n# Quick HTTP server\nserve() {\n    python3 -m http.server ${1:-8000}\n}
\n# Simple calculator\ncalc() {\n    python3 -c "from math import *; print($*)"\n}
\n# Get weather\nweather() {\n    curl -s "wttr.in/${1:-Beijing}"\n}
\n# Generate random password\ngenpass() {\n    openssl rand -base64 ${1:-16}\n}
\n# Count files by extension\nfilecount() {\n    find . -type f | sed "s/.*\\.//" | sort | uniq -c | sort -rn\n}
\n# Quick git log with stats\nglog() {\n    git log --oneline --stat $1 | less\n}
\n# Encode/decode base64\nb64enc() { echo -n "$1" | base64 }\nb64dec() { echo -n "$1" | base64 -d }
\n# Extract column from CSV\ncol() {\n    awk -F, "{print \$$1}" "$2"\n}
\n# Show top 10 largest files in current directory\nbigfiles() {\n    find . -type f -exec du -h {} + | sort -rh | head -10\n}
